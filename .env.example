# Directory where each brand's SQLite memory file lives (one file per brand_id).
KINOSTATE_MEMORY_DIR=~/.kinostate/brands

# Base Sepolia (testnet) — powers real on-chain provenance anchoring
# (anchor_provenance, FR-21). Generate a wallet locally with eth-account,
# fund it via a free Base Sepolia faucet, and put the private key here —
# never paste a private key anywhere else.
# BASE_RPC_URL=https://sepolia.base.org
BASE_WALLET_PRIVATE_KEY=

# Virtuals Protocol ACP — powers real provider-connection checks
# (register_provider, FR-23). Registration itself (job schema, pricing)
# happens on their dashboard, not here: sign up at
# https://app.virtuals.io/acp/join first, then fill these in from that
# registration. Never paste a private key anywhere else.
# VIRTUALS_WALLET_PRIVATE_KEY=
# VIRTUALS_AGENT_WALLET_ADDRESS=
# VIRTUALS_ENTITY_ID=

# x402 payment metering (meter_call, FR-19/20/22) on the free Base Sepolia
# testnet facilitator. This is a public receiving wallet ADDRESS only — no
# private key needed server-side, the facilitator settles from the
# payer's own signed authorization. Unset (the default) leaves /generate
# unmetered, exactly as before. Optional price override defaults in code.
# KINOSTATE_X402_PAY_TO_ADDRESS=
# KINOSTATE_X402_PRICE_USDC=
# X402_FACILITATOR_URL=https://x402.org/facilitator

# Not yet wired up (ACP job/escrow flows are still stubbed).

# fal.ai — powers the two live model adapters (kling_o1_reference,
# seedance), called directly by model path. Generate this at
# fal.ai/dashboard/keys -> Add Key.
FAL_KEY=

# Video model API keys — not required yet; these four adapters are still
# mocked (planned for after the hackathon).
# RUNWAY_API_KEY=
# PIKA_API_KEY=
# LUMA_API_KEY=
# KLING_API_KEY=

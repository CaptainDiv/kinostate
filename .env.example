# Directory where each brand's SQLite memory file lives (one file per brand_id).
KINOSTATE_MEMORY_DIR=~/.kinostate/brands

# Not yet wired up (economic layer is stubbed) — placeholders for when
# real Base/x402 and Virtuals ACP integration lands.
# BASE_RPC_URL=
# BASE_WALLET_PRIVATE_KEY=
# VIRTUALS_ACP_API_KEY=

# fal.ai — powers the two live model adapters (kling_o1_reference,
# seedance), called directly by model path. Generate this at
# fal.ai/dashboard/keys -> Add Key.
FAL_KEY=

# Video model API keys — not required yet; these four adapters are still
# mocked (planned for after the hackathon).
# RUNWAY_API_KEY=
# PIKA_API_KEY=
# LUMA_API_KEY=
# KLING_API_KEY=
